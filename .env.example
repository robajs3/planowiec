# Skopiuj ten plik do .env i uzupełnij wartości

SECRET_KEY=zmien-mnie-na-losowy-dlugi-ciag-znakow

# Opcja A: pełny connection string (ma pierwszeństwo, jeśli ustawiony)
# DATABASE_URL=postgresql+psycopg2://uzytkownik:haslo@localhost:5432/planowiec

# Opcja B: dane logowania do lokalnego Postgresa
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=planowiec

SESSION_COOKIE_SECURE=false

# SSO (LoginHub) — opcjonalne. Jeśli puste, appka po prostu nie loguje
# automatycznie przez SSO (nic się nie psuje, zostaje zwykły /auth/login).
SSO_SECRET=
HUB_INTERNAL_URL=http://hub-web:8000

# Import z koloseum: koloseum działa jako usługa systemd na hoście (nie w
# Dockerze), więc pod http://hub-web:8000 go nie ma. Domyślnie łączymy się
# przez host.docker.internal (patrz extra_hosts w docker-compose.yml) —
# WYMAGA, żeby koloseum nasłuchiwało na 0.0.0.0:5001, a nie tylko na
# 127.0.0.1:5001 (inaczej host.docker.internal nie dobije się do niego).
KOLOSEUM_INTERNAL_URL=http://host.docker.internal:5001
