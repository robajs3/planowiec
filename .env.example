# Skopiuj ten plik do .env i uzupełnij wartości

SECRET_KEY=zmien-mnie-na-losowy-dlugi-ciag-znakow

# Opcja A: pełny connection string (ma pierwszeństwo, jeśli ustawiony)
# DATABASE_URL=postgresql+psycopg2://uzytkownik:haslo@localhost:5432/planowiec

# Opcja B: dane logowania do lokalnego Postgresa
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=planowiec

SESSION_COOKIE_SECURE=false

# SSO (LoginHub) — opcjonalne. Jeśli puste, appka po prostu nie loguje
# automatycznie przez SSO (nic się nie psuje, zostaje zwykły /auth/login).
SSO_SECRET=
HUB_INTERNAL_URL=http://hub-web:8000

# Import z koloseum: koloseum jest teraz też dockerowe, w tej samej sieci
# sso_net — łączymy się po nazwie kontenera (koloseum-web), tak samo jak
# z hub-web.
KOLOSEUM_INTERNAL_URL=http://koloseum-web:5000
