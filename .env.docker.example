# Skopiuj do .env (w tym samym katalogu co docker-compose.yml) i uzupełnij.
# docker-compose automatycznie wczyta plik .env.

SECRET_KEY=zmien-mnie-na-losowy-dlugi-ciag-znakow

DB_USER=planowiec_user
DB_PASSWORD=zmien-to-haslo
DB_NAME=planowiec

# Port na hoście, pod którym appka będzie dostępna lokalnie
# (to właśnie ten port wskazujesz w `tailscale serve`).
APP_PORT=5000

# false w sieci lokalnej/Tailscale bez HTTPS terminowanego przez appkę
# (Tailscale Serve i tak terminuje TLS za Ciebie, appka widzi zwykłe HTTP).
SESSION_COOKIE_SECURE=false

# Zostaw puste, jeśli appka ma stać pod "/".
# Ustaw np. "/planowiec", jeśli wystawiasz ją pod prefiksem przez
# `tailscale serve --set-path /planowiec http://127.0.0.1:5000`,
# żeby nie kolidować z inną appką na tej samej domenie.
PREFIX=

# SSO (LoginHub) — SSO_SECRET musi być DOKŁADNIE tą samą wartością co w .env
# LoginHub. Appka dockerowa podłączona do sso_net gada z hub-web po nazwie
# kontenera, stąd domyślny HUB_INTERNAL_URL poniżej.
SSO_SECRET=
HUB_INTERNAL_URL=http://hub-web:8000

# Import z koloseum (systemd na hoście, nie w Dockerze) — wymaga koloseum
# nasłuchującego na 0.0.0.0:5001 (nie tylko 127.0.0.1), inaczej
# host.docker.internal (extra_hosts w docker-compose.yml) nie dobije.
KOLOSEUM_INTERNAL_URL=http://host.docker.internal:5001
